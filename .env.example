# Additional directories allowed for read-only scanning.
# Use commas between entries.
STRAVIQUE_ALLOWED_SCAN_ROOTS=

# PostgreSQL runtime and isolated test databases.
STRAVIQUE_DB_URL=jdbc:postgresql://127.0.0.1:5432/stravique
STRAVIQUE_DB_USER=sainm
STRAVIQUE_DB_PASSWORD=
STRAVIQUE_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/stravique_test

# Optional connection used by the local database setup script.
STRAVIQUE_ADMIN_DB_URL=postgresql:///postgres

# Local backend and frontend ports.
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_DEFAULT_LOCALE=en-US

# Fallback language for API messages and report exports. Accepts en-US, zh-CN, or ja-JP.
# A request's lang parameter or Accept-Language header takes precedence.
STRAVIQUE_DEFAULT_LOCALE=en-US
